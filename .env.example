# ephem credentials — copy to `.env` and fill in. `.env` is git-ignored.
# All of the other ~11 sources need NO credentials; these two are optional and
# their sources stay inert until the values below are set.

# --- Space-Track.org (https://www.space-track.org) -------------------------
# A free account (register on the site) for operators with no public upstream
# feed: Kuiper, Iridium, ORBCOMM, AST. Provides GP/OMM elements.
SPACETRACK_IDENTITY=
SPACETRACK_PASSWORD=
# Optional: object-name patterns to query (comma-separated).
# SPACETRACK_GROUPS=KUIPER,IRIDIUM,ORBCOMM,BLUEWALKER,BLUEBIRD
# Optional: override base URL.
# SPACETRACK_BASE_URL=https://www.space-track.org

# --- Spire Global orbit API (https://api.orb.spire.com) --------------------
# Commercial — there is no self-serve signup. Request access from Spire
# ("Space Services" / contact sales at spire.com, or developers.spire.com);
# they issue an API key. Paste it here once you have it.
SPIRE_API_KEY=
# Optional: endpoints to fetch (comma-separated paths).
# SPIRE_ENDPOINTS=/ephemeris,/tle
# Optional: override base URL.
# SPIRE_BASE_URL=https://api.orb.spire.com

# --- SDN publishing (optional) ---------------------------------------------
# 12/24-word HD-wallet mnemonic used to SIGN the SDN bundle PLG listings +
# protected artifacts (npm run build:bundles). Omit to use a generated DEV key.
# SDN_PUBLISHER_MNEMONIC=

# --- JSC Vimpel catalog (http://spacedata.vimpel.ru) -----------------------
# Independent Russian GEO/HEO catalog. Register manually at
# http://spacedata.vimpel.ru/ru/user/register (CAPTCHA + approval), then:
VIMPEL_IDENTITY=
VIMPEL_PASSWORD=
# Base URL is HTTP-only (the portal's TLS cert is dead) — leave as default.
# VIMPEL_BASE_URL=http://spacedata.vimpel.ru

# --- EDC / DGFI-TUM (full ILRS CPF: LAGEOS, LARES, Etalon, Sentinel, Jason...) -
# Free account at https://edc.dgfi.tum.de. The anonymous `cpf` source covers
# ESA Galileo only; EDC adds the full laser-target set.
EDC_USERNAME=
EDC_PASSWORD=
# Optional: provider filter, satellite-name filter (comma list), max targets.
# EDC_PROVIDER=
# EDC_SATELLITES=lageos1,lageos2,lares,etalon1,etalon2,sentinel3a,jason3
# EDC_MAX=200
# EDC_API_URL=https://edc.dgfi.tum.de/api/v1/
